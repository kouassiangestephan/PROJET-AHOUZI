model BarOrder {
  id          String   @id @default(uuid())
  propertyId  String
  status      String   @default("PENDING")
  totalAmount Decimal  @db.Decimal(12, 2)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property      @relation(fields: [propertyId], references: [id])
  items    BarOrderItem[]

  @@map("bar_orders")
  @@index([propertyId])
}

model BarOrderItem {
  id         String  @id @default(uuid())
  orderId    String
  itemId     String
  quantity   Decimal @db.Decimal(10, 2)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  order BarOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item  BarItem  @relation(fields: [itemId], references: [id])

  @@map("bar_order_items")
  @@index([orderId])
}

// ============================================================
// BOUTIQUE
// ============================================================

model ShopProduct {
  id           String   @id @default(uuid())
  propertyId   String
  name         String
  category     String
  barcode      String?
  currentStock Int      @default(0)
  minStock     Int      @default(0)
  sellingPrice Decimal  @db.Decimal(10, 2)
  costPrice    Decimal  @default(0) @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  saleItems  ShopSaleItem[]

  @@map("shop_products")
  @@index([propertyId])
  @@index([barcode])
}

model ShopSale {
  id            String   @id @default(uuid())
  propertyId    String
  status        String   @default("COMPLETED")
  subtotal      Decimal  @db.Decimal(12, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)
  paymentMethod String   @default("CASH")
  customerId    String?
  createdById   String?
  createdAt     DateTime @default(now())

  property  Property      @relation(fields: [propertyId], references: [id])
  customer  Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     ShopSaleItem[]

  @@map("shop_sales")
  @@index([propertyId])
}

model ShopSaleItem {
  id         String  @id @default(uuid())
  saleId     String
  productId  String
  quantity   Int
  unitPrice  Decimal @db.Decimal(10, 2)
  discount   Decimal @default(0) @db.Decimal(5, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  sale    ShopSale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product ShopProduct @relation(fields: [productId], references: [id])

  @@map("shop_sale_items")
  @@index([saleId])
}

// ============================================================
// SERVICES
// ============================================================

model Service {
  id          String   @id @default(uuid())
  propertyId  String
  name        String
  category    String
  price       Decimal  @db.Decimal(10, 2)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  property            Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservationServices ReservationService[]
  bookings            ServiceBooking[]

  @@map("services")
  @@index([propertyId])
}

model ServiceBooking {
  id            String    @id @default(uuid())
  propertyId    String
  customerId    String?
  reservationId String?
  serviceId     String
  status        String    @default("PENDING")
  scheduledAt   DateTime?
  completedAt   DateTime?
  amount        Decimal   @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime  @default(now())

  property    Property     @relation(fields: [propertyId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  service     Service      @relation(fields: [serviceId], references: [id])

  @@map("service_bookings")
  @@index([propertyId])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String
  channel   String    @default("IN_APP")
  status    String    @default("PENDING")
  metadata  Json?
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId])
  @@index([status])
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String
  channel   String
  subject   String?
  body      String
  variables Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

model NotificationSetting {
  id        String  @id @default(uuid())
  userId    String
  channel   String
  eventType String
  isEnabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, eventType])
  @@map("notification_settings")
}

// ============================================================
// RAPPORTS & CONFIGURATION
// ============================================================

model Report {
  id            String   @id @default(uuid())
  propertyId    String?
  name          String
  type          String
  parameters    Json?
  generatedById String?
  fileUrl       String?
  createdAt     DateTime @default(now())

  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  generatedBy User?     @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@map("reports")
  @@index([propertyId])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  type        String   @default("STRING")
  description String?
  isPublic    Boolean  @default(false)
  updatedById String?
  updatedAt   DateTime @updatedAt

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model PropertySetting {
  id         String   @id @default(uuid())
  propertyId String
  key        String
  value      String
  type       String   @default("STRING")
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, key])
  @@map("property_settings")
}
