// Schéma Prisma - Plateforme AHOUZI
// Villas Ahouzi ERP Suite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTIFICATION & UTILISATEURS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  GENERAL_MANAGER
  PROPERTY_MANAGER
  RECEPTIONIST
  ACCOUNTANT
  HR_MANAGER
  HOUSEKEEPING_STAFF
  MAINTENANCE_TECH
  RESTAURANT_MANAGER
  STORE_MANAGER
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  firstName            String
  lastName             String
  phone                String?
  avatar               String?
  role                 UserRole  @default(RECEPTIONIST)
  isActive             Boolean   @default(true)
  isTwoFactorEnabled   Boolean   @default(false)
  twoFactorSecret      String?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
  properties           PropertyUser[]
  housekeepingTasks    HousekeepingTask[]   @relation("AssignedTo")
  verifiedInspections  RoomInspection[]     @relation("InspectedBy")
  maintenanceTickets   MaintenanceTicket[]  @relation("AssignedTech")
  reportedTickets      MaintenanceTicket[]  @relation("ReportedBy")
  maintenanceComments  MaintenanceComment[]
  createdInvoices      Invoice[]
  createdPayments      Payment[]
  cashTransactions     CashTransaction[]
  postedJournalEntries JournalEntry[]       @relation("PostedBy")
  createdJournalEntries JournalEntry[]      @relation("CreatedBy")
  approvedExpenses     Expense[]            @relation("ApprovedBy")
  paidExpenses         Expense[]            @relation("PaidBy")
  createdExpenses      Expense[]            @relation("CreatedBy")
  employee             Employee?
  approvedLeaves       LeaveRequest[]
  createdPurchaseOrders PurchaseOrder[]
  performedStockMovements StockMovement[]
  restaurantOrders     RestaurantOrder[]
  notifications        Notification[]
  notificationSettings NotificationSetting[]
  reports              Report[]
  updatedSettings      SystemSetting[]
  reservationsCreated  Reservation[]        @relation("CreatedBy")
  reservationsUpdated  Reservation[]        @relation("UpdatedBy")
  housekeepingVerified HousekeepingTask[]   @relation("VerifiedBy")
  inventoryCounts      InventoryCount[]

  @@map("users")
  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@index([token])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([userId])
  @@index([resource, resourceId])
  @@index([createdAt])
}

// ============================================================
// PROPRIÉTÉS
// ============================================================

enum PropertyType {
  HOTEL
  RESIDENCE
  VILLA
  MIXED
}

model Property {
  id           String       @id @default(uuid())
  name         String
  code         String       @unique
  type         PropertyType @default(HOTEL)
  address      String
  city         String
  country      String       @default("Côte d'Ivoire")
  phone        String?
  email        String?
  website      String?
  description  String?
  checkInTime  String       @default("14:00")
  checkOutTime String       @default("12:00")
  currency     String       @default("XOF")
  timezone     String       @default("Africa/Abidjan")
  isActive     Boolean      @default(true)
  images       Json?
  amenities    Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  users              PropertyUser[]
  buildings          Building[]
  floors             Floor[]
  rooms              Room[]
  roomTypes          RoomType[]
  ratePlans          RatePlan[]
  reservations       Reservation[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  invoices           Invoice[]
  payments           Payment[]
  cashRegisters      CashRegister[]
  bankAccounts       BankAccount[]
  journalEntries     JournalEntry[]
  chartOfAccounts    ChartOfAccounts[]
  expenses           Expense[]
  recurringExpenses  RecurringExpense[]
  budgets            Budget[]
  departments        Department[]
  inventoryItems     InventoryItem[]
  purchaseOrders     PurchaseOrder[]
  inventoryCounts    InventoryCount[]
  laundryItems       LaundryItem[]
  laundryBatches     LaundryBatch[]
  restaurantTables   RestaurantTable[]
  menuCategories     MenuCategory[]
  menuItems          MenuItem[]
  restaurantOrders   RestaurantOrder[]
  barItems           BarItem[]
  barOrders          BarOrder[]
  shopProducts       ShopProduct[]
  shopSales          ShopSale[]
  services           Service[]
  serviceBookings    ServiceBooking[]
  reports            Report[]
  propertySettings   PropertySetting[]
  housekeepingSchedules HousekeepingSchedule[]

  @@map("properties")
  @@index([code])
  @@index([isActive])
}

model PropertyUser {
  id         String   @id @default(uuid())
  propertyId String
  userId     String
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([propertyId, userId])
  @@map("property_users")
}

model Building {
  id          String   @id @default(uuid())
  propertyId  String
  name        String
  floors      Int      @default(1)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  floorList Floor[]
  rooms     Room[]

  @@map("buildings")
  @@index([propertyId])
}

model Floor {
  id         String   @id @default(uuid())
  propertyId String
  buildingId String?
  number     Int
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  prop     Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms    Room[]

  @@map("floors")
  @@index([propertyId])
  @@index([buildingId])
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum RoomCategory {
  STANDARD
  SUPERIOR
  DELUXE
  SUITE
  VILLA
  APARTMENT
  STUDIO
  PENTHOUSE
}

model Room {
  id           String       @id @default(uuid())
  propertyId   String
  buildingId   String?
  floorId      String?
  roomTypeId   String?
  number       String
  name         String?
  category     RoomCategory @default(STANDARD)
  status       RoomStatus   @default(AVAILABLE)
  maxOccupancy Int          @default(2)
  basePrice    Decimal      @db.Decimal(12, 2)
  description  String?
  amenities    Json?
  images       Json?
  area         Float?
  bedType      String?
  bathrooms    Int          @default(1)
  floor        Int          @default(1)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  property         Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  building         Building?          @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  floorRef         Floor?             @relation(fields: [floorId], references: [id], onDelete: SetNull)
  roomType         RoomType?          @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)
  reservations     Reservation[]
  housekeepingTasks HousekeepingTask[]
  inspections      RoomInspection[]
  maintenanceTickets MaintenanceTicket[]
  laundryAssignments LaundryAssignment[]

  @@map("rooms")
  @@index([propertyId])
  @@index([status])
  @@index([number])
}

model RoomType {
  id           String   @id @default(uuid())
  propertyId   String
  name         String
  description  String?
  maxOccupancy Int      @default(2)
  basePrice    Decimal  @db.Decimal(12, 2)
  amenities    Json?
  images       Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  rooms         Room[]
  seasonalRates SeasonalRate[]

  @@map("room_types")
  @@index([propertyId])
}

model RatePlan {
  id                  String   @id @default(uuid())
  propertyId          String
  name                String
  description         String?
  type                String   @default("STANDARD")
  discountType        String?
  discountValue       Decimal? @db.Decimal(8, 2)
  minNights           Int?
  maxNights           Int?
  advanceBookingDays  Int?
  isActive            Boolean  @default(true)
  validFrom           DateTime?
  validTo             DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  property      Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  seasonalRates SeasonalRate[]

  @@map("rate_plans")
  @@index([propertyId])
}

model SeasonalRate {
  id         String   @id @default(uuid())
  roomTypeId String
  ratePlanId String
  price      Decimal  @db.Decimal(12, 2)
  startDate  DateTime
  endDate    DateTime
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  roomType RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  ratePlan RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

  @@map("seasonal_rates")
  @@index([roomTypeId])
  @@index([ratePlanId])
}

// ============================================================
// CLIENTS
// ============================================================

enum LoyaltyLevel {
  STANDARD
  SILVER
  GOLD
  VIP
}

enum IdDocumentType {
  PASSPORT
  NATIONAL_ID
  DRIVERS_LICENSE
  RESIDENT_PERMIT
}

model Customer {
  id               String         @id @default(uuid())
  firstName        String
  lastName         String
  email            String?
  phone            String
  nationality      String?
  idType           IdDocumentType?
  idNumber         String?
  idExpiry         DateTime?
  dateOfBirth      DateTime?
  address          String?
  city             String?
  country          String?
  loyaltyLevel     LoyaltyLevel   @default(STANDARD)
  loyaltyPoints    Int            @default(0)
  totalStays       Int            @default(0)
  totalSpent       Decimal        @default(0) @db.Decimal(15, 2)
  notes            String?
  blacklisted      Boolean        @default(false)
  blacklistReason  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  documents           CustomerDocument[]
  loyaltyTransactions LoyaltyTransaction[]
  reservations        Reservation[]
  invoices            Invoice[]
  payments            Payment[]
  restaurantOrders    RestaurantOrder[]
  shopSales           ShopSale[]
  serviceBookings     ServiceBooking[]

  @@map("customers")
  @@index([email])
  @@index([phone])
  @@index([loyaltyLevel])
}

model CustomerDocument {
  id         String   @id @default(uuid())
  customerId String
  type       String
  number     String
  issuedAt   DateTime?
  expiresAt  DateTime?
  fileUrl    String?
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_documents")
  @@index([customerId])
}

model LoyaltyTransaction {
  id            String   @id @default(uuid())
  customerId    String
  points        Int
  type          String
  description   String
  reservationId String?
  createdAt     DateTime @default(now())

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@map("loyalty_transactions")
  @@index([customerId])
}

// ============================================================
// RÉSERVATIONS
// ============================================================

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum BookingSource {
  DIRECT
  WEBSITE
  PHONE
  WALKIN
  OTA
  AGENCY
}

model Reservation {
  id                 String            @id @default(uuid())
  code               String            @unique
  propertyId         String
  customerId         String
  roomId             String
  status             ReservationStatus @default(PENDING)
  checkIn            DateTime
  checkOut           DateTime
  nights             Int
  adults             Int               @default(1)
  children           Int               @default(0)
  baseAmount         Decimal           @db.Decimal(12, 2)
  taxAmount          Decimal           @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount        Decimal           @db.Decimal(12, 2)
  paidAmount         Decimal           @default(0) @db.Decimal(12, 2)
  balanceAmount      Decimal           @db.Decimal(12, 2)
  source             BookingSource     @default(DIRECT)
  notes              String?
  specialRequests    String?
  cancellationReason String?
  cancelledAt        DateTime?
  checkedInAt        DateTime?
  checkedOutAt       DateTime?
  createdById        String?
  updatedById        String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  property            Property             @relation(fields: [propertyId], references: [id])
  customer            Customer             @relation(fields: [customerId], references: [id])
  room                Room                 @relation(fields: [roomId], references: [id])
  createdBy           User?                @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy           User?                @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  services            ReservationService[]
  extras              ReservationExtra[]
  invoices            Invoice[]
  payments            Payment[]
  loyaltyTransactions LoyaltyTransaction[]
  restaurantOrders    RestaurantOrder[]
  laundryAssignments  LaundryAssignment[]
  serviceBookings     ServiceBooking[]

  @@map("reservations")
  @@index([propertyId])
  @@index([customerId])
  @@index([roomId])
  @@index([status])
  @@index([checkIn, checkOut])
  @@index([code])
}

model ReservationService {
  id            String   @id @default(uuid())
  reservationId String
  serviceId     String
  quantity      Int      @default(1)
  unitPrice     Decimal  @db.Decimal(12, 2)
  totalPrice    Decimal  @db.Decimal(12, 2)
  date          DateTime?
  notes         String?
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id])

  @@map("reservation_services")
  @@index([reservationId])
}

model ReservationExtra {
  id            String   @id @default(uuid())
  reservationId String
  description   String
  amount        Decimal  @db.Decimal(12, 2)
  type          String
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("reservation_extras")
  @@index([reservationId])
}

model BookingChannel {
  id             String  @id @default(uuid())
  name           String
  commissionRate Decimal @default(0) @db.Decimal(5, 2)
  contactInfo    Json?
  isActive       Boolean @default(true)
  createdAt      DateTime @default(now())

  @@map("booking_channels")
}

// ============================================================
// HOUSEKEEPING
// ============================================================

enum HousekeepingTaskType {
  CHECKOUT_CLEAN
  STAYOVER_CLEAN
  DEEP_CLEAN
  TURNDOWN
  INSPECTION
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  VERIFIED
  SKIPPED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model HousekeepingTask {
  id           String                 @id @default(uuid())
  propertyId   String
  roomId       String
  assignedToId String?
  type         HousekeepingTaskType
  status       HousekeepingTaskStatus @default(PENDING)
  scheduledAt  DateTime
  startedAt    DateTime?
  completedAt  DateTime?
  verifiedById String?
  verifiedAt   DateTime?
  notes        String?
  priority     TaskPriority           @default(MEDIUM)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  property   Property        @relation(fields: [propertyId], references: [id])
  room       Room            @relation(fields: [roomId], references: [id])
  assignedTo User?           @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  verifiedBy User?           @relation("VerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  logs       HousekeepingLog[]

  @@map("housekeeping_tasks")
  @@index([propertyId])
  @@index([roomId])
  @@index([status])
  @@index([scheduledAt])
}

model HousekeepingLog {
  id          String   @id @default(uuid())
  taskId      String
  action      String
  performedById String?
  notes       String?
  createdAt   DateTime @default(now())

  task HousekeepingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("housekeeping_logs")
  @@index([taskId])
}

model RoomInspection {
  id           String   @id @default(uuid())
  roomId       String
  inspectedById String
  status       String
  checklist    Json?
  notes        String?
  images       Json?
  createdAt    DateTime @default(now())

  room        Room @relation(fields: [roomId], references: [id])
  inspectedBy User @relation("InspectedBy", fields: [inspectedById], references: [id])

  @@map("room_inspections")
  @@index([roomId])
  @@index([inspectedById])
}

model HousekeepingSchedule {
  id          String   @id @default(uuid())
  propertyId  String
  dayOfWeek   Int
  startTime   String
  endTime     String
  staffCount  Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("housekeeping_schedules")
  @@index([propertyId])
}

// ============================================================
// MAINTENANCE
// ============================================================

enum MaintenanceType {
  PLUMBING
  ELECTRICITY
  AIR_CONDITIONING
  INTERNET
  CARPENTRY
  METAL_WORKS
  GLASS_WORKS
  PAINTING
  CLEANING
  OTHER
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

model MaintenanceTicket {
  id             String            @id @default(uuid())
  code           String            @unique
  propertyId     String
  roomId         String?
  type           MaintenanceType
  priority       TaskPriority      @default(MEDIUM)
  status         MaintenanceStatus @default(OPEN)
  title          String
  description    String
  reportedById   String?
  assignedToId   String?
  estimatedCost  Decimal?          @db.Decimal(12, 2)
  actualCost     Decimal?          @db.Decimal(12, 2)
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  notes          String?
  images         Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  property   Property             @relation(fields: [propertyId], references: [id])
  room       Room?                @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reportedBy User?                @relation("ReportedBy", fields: [reportedById], references: [id], onDelete: SetNull)
  assignedTo User?                @relation("AssignedTech", fields: [assignedToId], references: [id], onDelete: SetNull)
  comments   MaintenanceComment[]
  parts      MaintenancePart[]

  @@map("maintenance_tickets")
  @@index([propertyId])
  @@index([status])
  @@index([code])
}

model MaintenanceComment {
  id         String   @id @default(uuid())
  ticketId   String
  authorId   String
  content    String
  isInternal Boolean  @default(false)
  createdAt  DateTime @default(now())

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User              @relation(fields: [authorId], references: [id])

  @@map("maintenance_comments")
  @@index([ticketId])
}

model MaintenancePart {
  id        String  @id @default(uuid())
  ticketId  String
  name      String
  quantity  Int
  unitCost  Decimal @db.Decimal(12, 2)
  totalCost Decimal @db.Decimal(12, 2)

  ticket MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("maintenance_parts")
  @@index([ticketId])
}

model MaintenanceCategory {
  id          String @id @default(uuid())
  name        String
  description String?
  slaHours    Int    @default(24)

  @@map("maintenance_categories")
}

// ============================================================
// FINANCE
// ============================================================

enum InvoiceType {
  PROFORMA
  FINAL
  CREDIT_NOTE
  RECEIPT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIAL
  OVERDUE
  CANCELLED
  VOID
}

model Invoice {
  id             String        @id @default(uuid())
  number         String        @unique
  propertyId     String
  customerId     String
  reservationId  String?
  type           InvoiceType   @default(FINAL)
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  subtotal       Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount  Decimal       @db.Decimal(12, 2)
  notes          String?
  terms          String?
  currency       String        @default("XOF")
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  property    Property      @relation(fields: [propertyId], references: [id])
  customer    Customer      @relation(fields: [customerId], references: [id])
  reservation Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items       InvoiceItem[]
  payments    Payment[]

  @@map("invoices")
  @@index([propertyId])
  @@index([customerId])
  @@index([status])
  @@index([number])
}

model InvoiceItem {
  id          String  @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(5, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  totalPrice  Decimal @db.Decimal(12, 2)
  serviceDate DateTime?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  CHECK
  CINETPAY
  PAYDUNYA
  WAVE
  ORANGE_MONEY
  MTN_MONEY
  MOOV_MONEY
  DJAMO
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

model Payment {
  id              String        @id @default(uuid())
  propertyId      String
  customerId      String
  reservationId   String?
  invoiceId       String?
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("XOF")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  reference       String?
  gatewayResponse Json?
  processedAt     DateTime?
  createdById     String?
  createdAt       DateTime      @default(now())

  property    Property     @relation(fields: [propertyId], references: [id])
  customer    Customer     @relation(fields: [customerId], references: [id])
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("payments")
  @@index([propertyId])
  @@index([customerId])
  @@index([status])
  @@index([reference])
}

model CashRegister {
  id             String   @id @default(uuid())
  propertyId     String
  name           String
  currentBalance Decimal  @default(0) @db.Decimal(12, 2)
  currency       String   @default("XOF")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property     Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transactions CashTransaction[]

  @@map("cash_registers")
  @@index([propertyId])
}

model CashTransaction {
  id          String   @id @default(uuid())
  registerId  String
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  description String
  reference   String?
  createdById String?
  createdAt   DateTime @default(now())

  register  CashRegister @relation(fields: [registerId], references: [id])
  createdBy User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("cash_transactions")
  @@index([registerId])
}

model BankAccount {
  id             String   @id @default(uuid())
  propertyId     String
  bankName       String
  accountNumber  String
  accountName    String
  currency       String   @default("XOF")
  currentBalance Decimal  @default(0) @db.Decimal(15, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transactions BankTransaction[]

  @@map("bank_accounts")
  @@index([propertyId])
}

model BankTransaction {
  id              String   @id @default(uuid())
  bankAccountId   String
  type            String
  amount          Decimal  @db.Decimal(12, 2)
  description     String
  reference       String?
  transactionDate DateTime
  reconciledAt    DateTime?
  createdAt       DateTime @default(now())

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@map("bank_transactions")
  @@index([bankAccountId])
}

model ChartOfAccounts {
  id         String   @id @default(uuid())
  propertyId String
  code       String
  name       String
  type       String
  subtype    String?
  parentId   String?
  isActive   Boolean  @default(true)
  balance    Decimal  @default(0) @db.Decimal(15, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  parent       ChartOfAccounts?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children     ChartOfAccounts[] @relation("AccountHierarchy")
  journalLines JournalLine[]

  @@unique([propertyId, code])
  @@map("chart_of_accounts")
  @@index([propertyId])
}

model JournalEntry {
  id          String   @id @default(uuid())
  propertyId  String
  number      String
  date        DateTime
  description String
  type        String
  totalDebit  Decimal  @db.Decimal(15, 2)
  totalCredit Decimal  @db.Decimal(15, 2)
  isPosted    Boolean  @default(false)
  postedById  String?
  postedAt    DateTime?
  createdById String?
  createdAt   DateTime @default(now())

  property  Property     @relation(fields: [propertyId], references: [id])
  postedBy  User?        @relation("PostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  createdBy User?        @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  lines     JournalLine[]

  @@map("journal_entries")
  @@index([propertyId])
  @@index([number])
}

model JournalLine {
  id             String  @id @default(uuid())
  journalEntryId String
  accountId      String
  description    String?
  debit          Decimal @default(0) @db.Decimal(15, 2)
  credit         Decimal @default(0) @db.Decimal(15, 2)

  journalEntry JournalEntry    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccounts @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
  @@index([journalEntryId])
  @@index([accountId])
}

model TaxRate {
  id          String   @id @default(uuid())
  name        String
  rate        Decimal  @db.Decimal(5, 2)
  type        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("tax_rates")
}

// ============================================================
// DÉPENSES
// ============================================================

model ExpenseCategory {
  id          String   @id @default(uuid())
  name        String
  type        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  budgets           Budget[]

  @@map("expense_categories")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  PAID
  OVERDUE
  CANCELLED
}

model Expense {
  id            String        @id @default(uuid())
  propertyId    String
  categoryId    String
  title         String
  description   String?
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("XOF")
  date          DateTime
  dueDate       DateTime?
  status        ExpenseStatus @default(PENDING)
  paymentMethod String?
  reference     String?
  receiptUrl    String?
  approvedById  String?
  approvedAt    DateTime?
  paidById      String?
  paidAt        DateTime?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  property    Property        @relation(fields: [propertyId], references: [id])
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])
  approvedBy  User?           @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  paidBy      User?           @relation("PaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@map("expenses")
  @@index([propertyId])
  @@index([status])
  @@index([date])
}

model RecurringExpense {
  id              String   @id @default(uuid())
  propertyId      String
  categoryId      String
  title           String
  amount          Decimal  @db.Decimal(12, 2)
  frequency       String
  nextDueDate     DateTime
  lastGeneratedAt DateTime?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@map("recurring_expenses")
  @@index([propertyId])
}

model Budget {
  id              String   @id @default(uuid())
  propertyId      String
  year            Int
  month           Int
  categoryId      String
  budgetedAmount  Decimal  @db.Decimal(12, 2)
  actualAmount    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@unique([propertyId, year, month, categoryId])
  @@map("budgets")
  @@index([propertyId])
}

// ============================================================
// RESSOURCES HUMAINES
// ============================================================

model Department {
  id          String   @id @default(uuid())
  propertyId  String
  name        String
  description String?
  managerId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@map("departments")
  @@index([propertyId])
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
  PROBATION
}

enum ContractType {
  PERMANENT
  TEMPORARY
  INTERN
  PARTTIME
}

model Employee {
  id              String         @id @default(uuid())
  userId          String?        @unique
  propertyId      String
  departmentId    String?
  employeeNumber  String         @unique
  firstName       String
  lastName        String
  email           String?
  phone           String
  position        String
  contractType    ContractType   @default(PERMANENT)
  salary          Decimal        @db.Decimal(12, 2)
  salaryType      String         @default("MONTHLY")
  hireDate        DateTime
  terminationDate DateTime?
  status          EmployeeStatus @default(ACTIVE)
  emergencyContact Json?
  bankAccount     Json?
  documents       Json?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  department    Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  contracts     Contract[]
  attendances   Attendance[]
  leaveRequests LeaveRequest[]
  payrollLines  PayrollLine[]
  bonuses       Bonus[]
  salaryAdvances SalaryAdvance[]
  disciplinaryActions DisciplinaryAction[]

  @@map("employees")
  @@index([propertyId])
  @@index([status])
  @@index([employeeNumber])
}

model Contract {
  id         String   @id @default(uuid())
  employeeId String
  type       String
  startDate  DateTime
  endDate    DateTime?
  salary     Decimal  @db.Decimal(12, 2)
  position   String
  signedAt   DateTime?
  fileUrl    String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("contracts")
  @@index([employeeId])
}

model Attendance {
  id          String   @id @default(uuid())
  employeeId  String
  date        DateTime @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  hoursWorked Float?
  status      String   @default("PRESENT")
  notes       String?
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("attendances")
  @@index([employeeId])
  @@index([date])
}

model LeaveType {
  id           String @id @default(uuid())
  name         String
  daysPerYear  Int    @default(30)
  isPaid       Boolean @default(true)
  description  String?

  leaveRequests LeaveRequest[]

  @@map("leave_types")
}

model LeaveRequest {
  id           String   @id @default(uuid())
  employeeId   String
  leaveTypeId  String
  startDate    DateTime
  endDate      DateTime
  days         Int
  reason       String
  status       String   @default("PENDING")
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  approvedBy  User?     @relation(fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("leave_requests")
  @@index([employeeId])
  @@index([status])
}

model Payroll {
  id            String   @id @default(uuid())
  propertyId    String
  month         Int
  year          Int
  status        String   @default("DRAFT")
  processedAt   DateTime?
  totalGross    Decimal  @db.Decimal(15, 2)
  totalDeductions Decimal @default(0) @db.Decimal(15, 2)
  totalNet      Decimal  @db.Decimal(15, 2)
  approvedById  String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines PayrollLine[]

  @@unique([propertyId, month, year])
  @@map("payrolls")
}

model PayrollLine {
  id          String  @id @default(uuid())
  payrollId   String
  employeeId  String
  grossSalary Decimal @db.Decimal(12, 2)
  basicSalary Decimal @db.Decimal(12, 2)
  allowances  Json?
  deductions  Json?
  netSalary   Decimal @db.Decimal(12, 2)
  workedDays  Int     @default(0)
  leaveDays   Int     @default(0)

  payroll  Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])

  @@map("payroll_lines")
  @@index([payrollId])
  @@index([employeeId])
}

model Bonus {
  id         String   @id @default(uuid())
  employeeId String
  amount     Decimal  @db.Decimal(12, 2)
  type       String
  reason     String
  date       DateTime
  payrollId  String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("bonuses")
  @@index([employeeId])
}

model SalaryAdvance {
  id             String   @id @default(uuid())
  employeeId     String
  amount         Decimal  @db.Decimal(12, 2)
  reason         String
  date           DateTime
  repaymentDate  DateTime?
  status         String   @default("PENDING")
  approvedById   String?
  createdAt      DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salary_advances")
  @@index([employeeId])
}

model DisciplinaryAction {
  id          String   @id @default(uuid())
  employeeId  String
  type        String
  reason      String
  date        DateTime
  description String
  fileUrl     String?
  createdById String?
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("disciplinary_actions")
  @@index([employeeId])
}

// ============================================================
// INVENTAIRE
// ============================================================

model InventoryCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  parentId    String?
  createdAt   DateTime @default(now())

  parent   InventoryCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children InventoryCategory[] @relation("CategoryHierarchy")
  items    InventoryItem[]

  @@map("inventory_categories")
}

model InventoryItem {
  id            String   @id @default(uuid())
  propertyId    String
  categoryId    String?
  name          String
  sku           String?
  description   String?
  unit          String   @default("unité")
  currentStock  Decimal  @default(0) @db.Decimal(12, 3)
  minStock      Decimal  @default(0) @db.Decimal(12, 3)
  maxStock      Decimal? @db.Decimal(12, 3)
  reorderPoint  Decimal  @default(0) @db.Decimal(12, 3)
  unitCost      Decimal  @default(0) @db.Decimal(12, 2)
  location      String?
  supplierId    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property       Property           @relation(fields: [propertyId], references: [id])
  category       InventoryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier       Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements      StockMovement[]
  purchaseItems  PurchaseOrderItem[]
  countItems     InventoryCountItem[]

  @@map("inventory_items")
  @@index([propertyId])
  @@index([sku])
}

model StockMovement {
  id              String   @id @default(uuid())
  itemId          String
  propertyId      String
  type            String
  quantity        Decimal  @db.Decimal(12, 3)
  unitCost        Decimal? @db.Decimal(12, 2)
  totalCost       Decimal? @db.Decimal(12, 2)
  reference       String?
  reason          String?
  performedById   String?
  createdAt       DateTime @default(now())

  item        InventoryItem @relation(fields: [itemId], references: [id])
  performedBy User?         @relation(fields: [performedById], references: [id], onDelete: SetNull)

  @@map("stock_movements")
  @@index([itemId])
  @@index([propertyId])
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  paymentTerms  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model PurchaseOrder {
  id           String   @id @default(uuid())
  propertyId   String
  supplierId   String
  number       String   @unique
  status       String   @default("DRAFT")
  orderDate    DateTime @default(now())
  expectedDate DateTime?
  subtotal     Decimal  @db.Decimal(12, 2)
  taxAmount    Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount  Decimal  @db.Decimal(12, 2)
  notes        String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property   Property           @relation(fields: [propertyId], references: [id])
  supplier   Supplier           @relation(fields: [supplierId], references: [id])
  createdBy  User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items      PurchaseOrderItem[]

  @@map("purchase_orders")
  @@index([propertyId])
  @@index([status])
}

model PurchaseOrderItem {
  id               String  @id @default(uuid())
  purchaseOrderId  String
  itemId           String
  quantity         Decimal @db.Decimal(12, 3)
  unitPrice        Decimal @db.Decimal(12, 2)
  totalPrice       Decimal @db.Decimal(12, 2)
  receivedQuantity Decimal @default(0) @db.Decimal(12, 3)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          InventoryItem @relation(fields: [itemId], references: [id])

  @@map("purchase_order_items")
  @@index([purchaseOrderId])
}

model InventoryCount {
  id          String   @id @default(uuid())
  propertyId  String
  date        DateTime
  status      String   @default("DRAFT")
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property  Property             @relation(fields: [propertyId], references: [id])
  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     InventoryCountItem[]

  @@map("inventory_counts")
  @@index([propertyId])
}

model InventoryCountItem {
  id               String  @id @default(uuid())
  countId          String
  itemId           String
  expectedQuantity Decimal @db.Decimal(12, 3)
  actualQuantity   Decimal @db.Decimal(12, 3)
  variance         Decimal @db.Decimal(12, 3)
  notes            String?

  count InventoryCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  item  InventoryItem  @relation(fields: [itemId], references: [id])

  @@map("inventory_count_items")
  @@index([countId])
}

// ============================================================
// BLANCHISSERIE
// ============================================================

model LaundryItem {
  id                String   @id @default(uuid())
  propertyId        String
  name              String
  type              String
  totalQuantity     Int      @default(0)
  availableQuantity Int      @default(0)
  inWashQuantity    Int      @default(0)
  dirtyQuantity     Int      @default(0)
  lostQuantity      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  property   Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  batchItems LaundryBatchItem[]

  @@map("laundry_items")
  @@index([propertyId])
}

model LaundryBatch {
  id               String    @id @default(uuid())
  propertyId       String
  status           String    @default("DIRTY")
  collectedAt      DateTime  @default(now())
  washStartedAt    DateTime?
  washCompletedAt  DateTime?
  distributedAt    DateTime?
  collectedById    String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  property    Property           @relation(fields: [propertyId], references: [id])
  items       LaundryBatchItem[]
  assignments LaundryAssignment[]

  @@map("laundry_batches")
  @@index([propertyId])
}

model LaundryBatchItem {
  id        String @id @default(uuid())
  batchId   String
  itemId    String
  quantity  Int
  condition String @default("GOOD")

  batch LaundryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  item  LaundryItem  @relation(fields: [itemId], references: [id])

  @@map("laundry_batch_items")
  @@index([batchId])
}

model LaundryAssignment {
  id            String    @id @default(uuid())
  batchId       String
  roomId        String?
  reservationId String?
  distributedAt DateTime?
  returnedAt    DateTime?
  notes         String?
  createdAt     DateTime  @default(now())

  batch       LaundryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  room        Room?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@map("laundry_assignments")
  @@index([batchId])
}

// ============================================================
// RESTAURANT
// ============================================================

model RestaurantTable {
  id         String   @id @default(uuid())
  propertyId String
  number     String
  name       String?
  capacity   Int      @default(4)
  status     String   @default("AVAILABLE")
  section    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  orders   RestaurantOrder[]

  @@map("restaurant_tables")
  @@index([propertyId])
}

model MenuCategory {
  id         String   @id @default(uuid())
  propertyId String
  name       String
  description String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  menuItems MenuItem[]

  @@map("menu_categories")
  @@index([propertyId])
}

model MenuItem {
  id              String   @id @default(uuid())
  propertyId      String
  categoryId      String
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  cost            Decimal? @db.Decimal(10, 2)
  allergens       Json?
  images          Json?
  isAvailable     Boolean  @default(true)
  preparationTime Int      @default(15)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  property   Property             @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  category   MenuCategory         @relation(fields: [categoryId], references: [id])
  orderItems RestaurantOrderItem[]

  @@map("menu_items")
  @@index([propertyId])
  @@index([categoryId])
}

model RestaurantOrder {
  id            String   @id @default(uuid())
  propertyId    String
  tableId       String?
  reservationId String?
  customerId    String?
  status        String   @default("PENDING")
  type          String   @default("DINE_IN")
  subtotal      Decimal  @db.Decimal(12, 2)
  taxAmount     Decimal  @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal  @db.Decimal(12, 2)
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property      Property              @relation(fields: [propertyId], references: [id])
  table         RestaurantTable?       @relation(fields: [tableId], references: [id], onDelete: SetNull)
  reservation   Reservation?          @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  customer      Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy     User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items         RestaurantOrderItem[]
  kitchenTicket KitchenTicket?

  @@map("restaurant_orders")
  @@index([propertyId])
  @@index([status])
}

model RestaurantOrderItem {
  id         String  @id @default(uuid())
  orderId    String
  menuItemId String
  quantity   Int     @default(1)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)
  notes      String?
  status     String  @default("PENDING")

  order    RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem        @relation(fields: [menuItemId], references: [id])

  @@map("restaurant_order_items")
  @@index([orderId])
}

model KitchenTicket {
  id          String    @id @default(uuid())
  orderId     String    @unique
  status      String    @default("OPEN")
  priority    String    @default("NORMAL")
  notes       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  order RestaurantOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("kitchen_tickets")
  @@index([status])
}

// ============================================================
// BAR
